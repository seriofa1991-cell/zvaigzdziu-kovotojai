rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- SAVES (žaidėjų progresas) ----------
    // Doc ID = vartotojo vardas (mažosiomis raidėmis), ne Firebase UID.
    // "Raid" (užpuolimo) ir admin rubinų funkcijos sąmoningai rašo į
    // KITO žaidėjo saves dokumentą, todėl čia neriboju "gali rašyti tik
    // į savo dokumentą" — vietoj to ribojame PAČIAS REIKŠMES, kad
    // niekas negalėtų įrašyti neįmanomų skaičių (ir taip apsaugo visus
    // žaidėjus, kad ir kas rašytų).
    match /saves/{uk} {
      allow read: if true; // reitingo lentelei reikia skaityti visų žaidėjų pwr
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['json','savedAt','name','lvl'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 300000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.savedAt is number
        && request.resource.data.lvl is number
        && request.resource.data.lvl >= 1
        && request.resource.data.lvl <= 70
        && (!('pwr' in request.resource.data)
            || (request.resource.data.pwr is number
                && request.resource.data.pwr >= 0
                && request.resource.data.pwr <= 200000));
    }

    // ---------- USERNAMES (vartotojo vardas -> Firebase UID) ----------
    // Leidžiama tik susikurti SAVO įrašą (uid turi sutapti su prisijungusio
    // asmens UID) ir tik jei jo dar nėra arba jis jau priklauso tau —
    // taip niekas negali "pavogti" svetimo vartotojo vardo.
    match /usernames/{uk} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/usernames/$(uk))
            || resource.data.uid == request.auth.uid);
    }

    // ---------- GUILDS (gildijos) ----------
    // Bazinė apsauga: reikia būti prisijungus. Gilesnė iždo/narių
    // validacija (pvz. kad vienas narys negalėtų padvigubinti contrib
    // reikšmės) čia neįtraukta — jei nori, galiu ją padaryti atskirai.
    match /guilds/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Viskas kita — uždrausta pagal nutylėjimą.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
