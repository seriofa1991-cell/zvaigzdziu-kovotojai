rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- SAVES (žaidėjų progresas) ----------
    // Doc ID = vartotojo vardas (mažosiomis raidėmis), ne Firebase UID.
    // "Raid" (užpuolimo) ir admin rubinų funkcijos sąmoningai rašo į
    // KITO žaidėjo saves dokumentą, todėl čia neriboju "gali rašyti tik
    // į savo dokumentą" — vietoj to ribojame PAČIAS REIKŠMES, kad
    // niekas negalėtų įrašyti neįmanomų skaičių (ir taip apsaugo visus
    // žaidėjus, kad ir kas rašytų).
    match /saves/{uk} {
      allow read: if true; // reitingo lentelei reikia skaityti visų žaidėjų pwr
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['json','savedAt','name','lvl'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 300000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.savedAt is number
        && request.resource.data.lvl is number
        && request.resource.data.lvl >= 1
        && request.resource.data.lvl <= 70
        && (!('pwr' in request.resource.data)
            || (request.resource.data.pwr is number
                && request.resource.data.pwr >= 0
                && request.resource.data.pwr <= 200000));
    }

    // ---------- USERNAMES (vartotojo vardas -> Firebase UID) ----------
    // Leidžiama tik susikurti SAVO įrašą (uid turi sutapti su prisijungusio
    // asmens UID) ir tik jei jo dar nėra arba jis jau priklauso tau —
    // taip niekas negali "pavogti" svetimo vartotojo vardo.
    match /usernames/{uk} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/usernames/$(uk))
            || resource.data.uid == request.auth.uid);
    }

    // ---------- GUILDS (gildijos) ----------
    // Bazinė apsauga: reikia būti prisijungus. Gilesnė iždo/narių
    // validacija (pvz. kad vienas narys negalėtų padvigubinti contrib
    // reikšmės) čia neįtraukta — jei nori, galiu ją padaryti atskirai.
    match /guilds/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ---------- LISTINGS (prekyvietės skelbimai) ----------
    // Bet kas prisijungęs gali sukurti skelbimą su pagrįstomis reikšmėmis.
    // Trynimas leidžiamas bet kuriam prisijungusiam vartotojui, nes
    // pirkimo funkcija ištrina KITO žaidėjo skelbimą (pirkėjas, ne
    // pardavėjas) — tai sąmoningas pasirinkimas, atitinkantis esamą
    // "ribojame reikšmes, ne kas rašo" stilių.
    match /listings/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['id','seller','sellerName','item','price','listedAt','status'])
        && request.resource.data.id is string
        && request.resource.data.seller is string
        && request.resource.data.sellerName is string
        && request.resource.data.sellerName.size() <= 40
        && request.resource.data.item is map
        && request.resource.data.price is number
        && request.resource.data.price >= 1
        && request.resource.data.price <= 500000
        && request.resource.data.listedAt is number
        && request.resource.data.status == 'active';
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // ---------- CHAT (gildijos / globalus čatas) ----------
    // Tik kūrimas — žinučių niekas netrina ir neredaguoja iš kliento.
    match /chat/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['ch','uk','name','text','ts'])
        && request.resource.data.ch is string
        && request.resource.data.uk is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 200
        && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    // Viskas kita — uždrausta pagal nutylėjimą.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
